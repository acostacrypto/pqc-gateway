# syntax=docker/dockerfile:1
###############################################################################
#  Multi-stage image: Post-Quantum Cryptography (PQC)
#  Stage 1 (builder) : builds OpenSSL 3 + liboqs + oqs-provider from source
#  Stage 2 (runtime) : copies ONLY the installed artifacts (~400 MB smaller)
#
#  Build:  docker build -t pqc-image .
#  Run:    docker run --rm -it pqc-image
#  List:   docker run --rm pqc-image openssl list -providers
###############################################################################

ARG BASE_IMAGE=ubuntu:24.04
ARG OPENSSL_VERSION=3.5.5
ARG PREFIX=/opt/ossl

########################################################################
# STAGE 1 — BUILDER  (builds EVERYTHING from source)
########################################################################
FROM ${BASE_IMAGE} AS builder

ARG OPENSSL_VERSION
ARG PREFIX
ARG LIBOQS_REF=main
ARG OQS_PROVIDER_REF=main

ENV DEBIAN_FRONTEND=noninteractive

# --- Build dependencies ---------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        ninja-build \
        perl \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# --- 1) OpenSSL 3 from source --------------------------------------------
#     install_sw     -> libcrypto/libssl + openssl binary + headers
#     install_ssldirs -> creates ${PREFIX}/ssl with the base openssl.cnf
RUN curl -fsSL -o openssl.tar.gz \
        "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz" \
    && mkdir openssl \
    && tar -xzf openssl.tar.gz -C openssl --strip-components=1 \
    && cd openssl \
    && ./Configure \
           --prefix="${PREFIX}" \
           --openssldir="${PREFIX}/ssl" \
           --libdir=lib \
           shared no-tests \
    && make -j"$(nproc)" \
    && make install_sw install_ssldirs \
    && cd /src && rm -rf openssl openssl.tar.gz

# The rest of this stage links against the OpenSSL built above
ENV LD_LIBRARY_PATH=${PREFIX}/lib
ENV PATH=${PREFIX}/bin:$PATH

# --- 2) liboqs from source ------------------------------------------------
#     BUILD_SHARED_LIBS=ON -> liboqs.so
#     OQS_BUILD_TESTS=OFF  -> skips tests/test_kem, kat_*, speed_*
RUN git clone --depth 1 --branch "${LIBOQS_REF}" \
        https://github.com/open-quantum-safe/liboqs.git \
    && cmake -S liboqs -B liboqs/build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="${PREFIX}" \
        -DCMAKE_PREFIX_PATH="${PREFIX}" \
        -DOPENSSL_ROOT_DIR="${PREFIX}" \
        -DBUILD_SHARED_LIBS=ON \
        -DOQS_BUILD_TESTS=OFF \
        -DOQS_USE_OPENSSL=ON \
    && cmake --build liboqs/build \
    && cmake --install liboqs/build \
    && rm -rf liboqs

# --- 3) oqs-provider from source ------------------------------------------
#     The .so is copied to a fixed path so we do not depend on the MODULESDIR
#     that CMake resolves on each distro.
RUN git clone --depth 1 --branch "${OQS_PROVIDER_REF}" \
        https://github.com/open-quantum-safe/oqs-provider.git \
    && cmake -S oqs-provider -B oqs-provider/build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="${PREFIX}" \
        -DOPENSSL_ROOT_DIR="${PREFIX}" \
        -DOQS_PROVIDER_BUILD_TESTS=OFF \
    && cmake --build oqs-provider/build \
    && mkdir -p "${PREFIX}/lib/ossl-modules" \
    && cp oqs-provider/build/lib/oqsprovider.so \
          "${PREFIX}/lib/ossl-modules/oqsprovider.so" \
    && rm -rf oqs-provider

# --- 4) OpenSSL configuration ---------------------------------------------
#     A minimal, deterministic openssl.cnf is written. Key points:
#       * the "default" provider MUST be activated EXPLICITLY: in OpenSSL 3
#         it is only auto-loaded implicitly if NO other provider is activated
#         explicitly. Otherwise every key operation fails.
RUN printf '%s\n' \
      '# Generated by Dockerfile - PQC (post-quantum) image' \
      'openssl_conf = openssl_init' \
      '' \
      '[openssl_init]' \
      'providers = provider_sect' \
      '' \
      '[provider_sect]' \
      'default = default_sect' \
      'oqsprovider = oqsprovider_sect' \
      '' \
      '[default_sect]' \
      'activate = 1' \
      '' \
      '[oqsprovider_sect]' \
      "module = ${PREFIX}/lib/ossl-modules/oqsprovider.so" \
      'activate = 1' \
      > "${PREFIX}/ssl/openssl.cnf"

ENV OPENSSL_CONF=${PREFIX}/ssl/openssl.cnf
ENV OPENSSL_MODULES=${PREFIX}/lib/ossl-modules

# --- 5) Build-time smoke test (fails the build if anything goes wrong) -----
RUN echo "== version =="                       && openssl version -a \
    && echo "== providers =="                  && openssl list -providers \
    && echo "== KEM ML-KEM-768 =="             && openssl genpkey \
              -algorithm ML-KEM-768 -out /tmp/k.pem \
    && echo "== ML-DSA-65 signature =="        && openssl genpkey \
              -algorithm ML-DSA-65 -out /tmp/s.pem \
    && echo "hello PQC" > /tmp/f.txt \
    && openssl pkeyutl -sign -inkey /tmp/s.pem -in /tmp/f.txt -out /tmp/f.sig \
    && openssl pkey -in /tmp/s.pem -pubout -out /tmp/s.pub.pem \
    && openssl pkeyutl -verify -pubin -inkey /tmp/s.pub.pem \
              -sigfile /tmp/f.sig -in /tmp/f.txt \
    && echo "== algorithm listing =="          && openssl list -kem-algorithms \
    && rm -f /tmp/k.pem /tmp/s.pem /tmp/f.txt /tmp/f.sig /tmp/s.pub.pem

########################################################################
# STAGE 2 — RUNTIME  (only what is needed to run)
########################################################################
FROM ${BASE_IMAGE} AS runtime

ARG PREFIX=/opt/ossl

ENV DEBIAN_FRONTEND=noninteractive

# --no-install-recommends: only ca-certificates (for TLS)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Full copy of the tree installed by the builder stage
COPY --from=builder ${PREFIX} ${PREFIX}

# OpenSSL looks for the system certs in ${OPENSSLDIR}/certs and /cert.pem;
# we link the distro ones so s_client / TLS work.
RUN rm -rf "${PREFIX}/ssl/certs" \
    && ln -s /etc/ssl/certs "${PREFIX}/ssl/certs" \
    && ln -sf /etc/ssl/certs/ca-certificates.crt "${PREFIX}/ssl/cert.pem"

ENV PATH=${PREFIX}/bin:$PATH \
    LD_LIBRARY_PATH=${PREFIX}/lib \
    OPENSSL_CONF=${PREFIX}/ssl/openssl.cnf \
    OPENSSL_MODULES=${PREFIX}/lib/ossl-modules

WORKDIR /work

# Re-verification in the final image
RUN openssl version && openssl list -providers

CMD ["bash"]
